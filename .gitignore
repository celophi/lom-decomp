# Ignore the python virtual environment folder
.venv/

# Game data files placed in the disc folder cannot be committed due to copyright issues
disc/*

# Assembly output folder from splat
asm/

# Linker scripts and auto-generated undefined symbols/functions lists
linker/

# Build output folder
build/
output/

# Local generated files for matching purposes
.matching/

# Ignore generated C files
src/unk*.c
src/overlays/*/unk*.c

tools/splat_ext/__pycache__/

assets/

# m2c context cache files
*.m2c