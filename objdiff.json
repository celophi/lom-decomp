{
  "$schema": "https://raw.githubusercontent.com/encounter/objdiff/main/config.schema.json",
  "custom_make": "make objdiff-objects",
  "build_target": true,
  "build_base": true,
  "units": [
    {
      "name": "main/main",
      "target_path": "build/asm/main.o",
      "base_path": "build/src/main.o"
    },
    {
      "name": "main/cd",
      "target_path": "build/asm/cd.o",
      "base_path": "build/src/cd.o"
    },
    {
      "name": "main/main_continued",
      "target_path": "build/asm/main_continued.o",
      "base_path": "build/src/main_continued.o"
    },
    {
      "name": "main/psyq/libcd/SYS",
      "target_path": "build/asm/psyq/libcd/SYS.o",
      "base_path": "build/src/psyq/libcd/SYS.o"
    },
    {
      "name": "main/psyq_continued",
      "target_path": "build/asm/psyq_continued.o",
      "base_path": "build/src/psyq_continued.o"
    }
  ]
}